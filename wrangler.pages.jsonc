{
	"$schema": "./node_modules/wrangler/config-schema.json",

	// ---------------------------------------------------------------------
	// Cloudflare **Pages** 배포 전용 설정.
	//
	// 주 설정(wrangler.jsonc)은 Workers 타깃이며 로컬 개발/Playwright 가 그것을 쓴다.
	// 이 파일은 `npm run deploy:pages` 에서만 사용한다.
	//
	// 두 파일의 차이는 딱 하나다:
	//   Workers → "main" + "assets"           (워커가 진입점, 정적 자산은 바인딩)
	//   Pages   → "pages_build_output_dir"    (출력 디렉터리 전체를 Pages 가 서빙)
	//
	// 바인딩(D1/R2/vars)은 양쪽이 같아야 한다. 한쪽만 고치면 운영에서 바인딩이 사라진다.
	// ---------------------------------------------------------------------
	"name": "magichanjaadventure",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": ["nodejs_als"],

	"pages_build_output_dir": ".svelte-kit/cloudflare",

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "magichanja-db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "database/migrations"
		}
	],

	"r2_buckets": [
		{
			"binding": "ASSET_BUCKET",
			"bucket_name": "magichanja-assets"
		}
	],

	"vars": {
		"PUBLIC_APP_NAME": "마법한자탐험대",
		"APP_ENV": "production",
		"PUBLIC_ASSET_BASE": ""
	}
}
