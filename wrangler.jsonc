{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "magichanjaadventure",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	},

	// ---------------------------------------------------------------------
	// 명명된 환경(env.production 등)을 두지 않는다.
	//
	// wrangler 의 명명된 환경은 최상위 바인딩을 **상속하지 않는다.**
	// env.production 을 만들면 거기에도 d1/r2 를 다시 적어야 하고,
	// 빠뜨리면 "운영에 DB 가 없는" 상태로 배포된다. 1인 개발에서 가장 위험한 함정이라
	// 최상위 설정 하나만 두고, 로컬 차이는 .dev.vars 로 덮는다.
	// ---------------------------------------------------------------------

	// D1 — 게임 데이터베이스
	// database_id 는 로컬 개발/테스트에서 쓰이지 않는다(로컬 SQLite 상태를 사용).
	// PHASE 20 에서 `wrangler d1 create magichanja-db` 후 실제 ID 로 교체한다.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "magichanja-db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "database/migrations"
		}
	],

	// R2 — 이미지/사운드 에셋 (PHASE 15)
	// 정적 자산 바인딩(ASSETS)과 이름이 겹치지 않도록 ASSET_BUCKET 을 쓴다.
	"r2_buckets": [
		{
			"binding": "ASSET_BUCKET",
			"bucket_name": "magichanja-assets"
		}
	],

	// 공개 변수만 둔다. 시크릿은 절대 넣지 않는다.
	// 시크릿: `wrangler secret put`(운영) / `.dev.vars`(로컬, git 무시)
	//
	// 보안 판단(쿠키 Secure 등)은 이 값이 아니라 **요청 URL 의 프로토콜**로 결정한다.
	// 설정 실수로 운영에서 Secure 가 꺼지는 일이 없어야 하기 때문이다.
	"vars": {
		"PUBLIC_APP_NAME": "마법한자탐험대",
		"APP_ENV": "production",
		"PUBLIC_ASSET_BASE": ""
	}
}
