{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "magichanjaadventure",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": ["nodejs_als"],

	// ---------------------------------------------------------------------
	// Cloudflare **Pages** 설정.
	//
	// 왜 Pages 를 기준 파일로 두는가:
	//   `wrangler pages deploy` 는 --config 로 커스텀 경로를 받지 못한다.
	//   즉 루트의 wrangler.jsonc 가 Pages 설정이어야 **바인딩(D1/R2)이 배포에 함께 올라간다.**
	//   여기를 Workers 설정으로 두면 배포본에 DB 가 없는 상태가 되어 조용히 망가진다.
	//
	// 로컬 개발/프리뷰/E2E 도 같은 파일을 쓴다 (`wrangler pages dev`).
	// 개발·테스트·운영이 하나의 설정을 공유하므로 경로가 갈라지지 않는다.
	// ---------------------------------------------------------------------
	"pages_build_output_dir": ".svelte-kit/cloudflare",

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "magichanja-db",
			"database_id": "2d6ecb5a-a9d7-471f-8415-72978b117cec",
			"migrations_dir": "database/migrations"
		}
	],

	// ---------------------------------------------------------------------
	// R2 (에셋 저장소) — **아직 연결하지 않았다.**
	//
	// 계정에서 R2 를 활성화해야 버킷을 만들 수 있고, 활성화에는 결제수단 등록이 필요하다.
	// 지금은 코드가 R2 를 쓰지 않으므로 바인딩을 넣지 않는다.
	// 존재하지 않는 버킷을 바인딩하면 **배포 자체가 실패**하기 때문이다.
	//
	// PHASE 15 에서 실제로 필요해지면 아래를 되살린다:
	//   "r2_buckets": [{ "binding": "ASSET_BUCKET", "bucket_name": "magichanja-assets" }],
	// ---------------------------------------------------------------------

	// 공개 변수만 둔다. 시크릿은 `wrangler pages secret put` / `.dev.vars` 로만 다룬다.
	// 보안 판단(쿠키 Secure 등)은 이 값이 아니라 요청 URL 의 프로토콜로 결정한다.
	"vars": {
		"PUBLIC_APP_NAME": "마법한자탐험대",
		"APP_ENV": "production"
	}
}
