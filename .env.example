# ============================================================
# 마법한자탐험대 — 환경변수 예시
# ============================================================
# 이 파일(.env.example)만 저장소에 커밋한다.
# 실제 값이 들어간 .env / .dev.vars 는 .gitignore 에 있으며 절대 커밋하지 않는다.
#
# Cloudflare Workers 로컬 개발에서는 `.dev.vars` 가 표준이다.
#   cp .env.example .dev.vars
# 운영 시크릿은 `wrangler secret put <NAME>` 으로 등록한다.
# ============================================================

# ---- 공개 변수 (클라이언트에 노출되어도 무방) -------------------------------
PUBLIC_APP_NAME=마법한자탐험대

# 앱 환경: development | preview | production
APP_ENV=development

# R2 공개 에셋 베이스 URL (PHASE 15). 비워두면 static/ 에서 제공한다.
PUBLIC_ASSET_BASE=

# Cloudflare Web Analytics 의 beacon 토큰. **한자사전에만** 쓰인다.
# (게임에는 달지 않는다 — 아이 브라우저가 제3자에게 요청을 보내지 않는다는
#  원칙이 app.html 에 적혀 있다. 이유는 src/routes/hanja/+layout.svelte 참고.)
#
# 받는 곳: Cloudflare 대시보드 → Web Analytics → Add a site
#          → hanjasajeon.pages.dev → 스니펫의 "token" 값
#
# 비워 두면 계측이 통째로 빠진다. 페이지 소스에 그대로 실리는 공개 식별자이지만,
# 값은 저장소가 아니라 .env 에 둔다.
PUBLIC_CF_BEACON=

# ---- 시크릿 (절대 커밋 금지) -------------------------------------------------
# 세션 쿠키 서명/부가 엔트로피용 키.
# 생성 예: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=replace-with-a-long-random-value

# ---- 배포용 (로컬 .env 에는 보통 불필요) -------------------------------------
# wrangler 는 `wrangler login` 을 쓰는 것이 안전하다. 토큰을 파일에 두지 않는 편이 좋다.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
